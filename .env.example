# Payment methods are recorded for manual merchant verification before approval.
# The current MVP does not charge cards or reconcile bank transfers automatically.
# Base de datos: SQLite local por defecto. Para Supabase/Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:<pass>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./sabi.db

# Anthropic (dejá AGENT_MOCK_MODE=true para probar sin API key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_MOCK_MODE=true

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=sabi-verify-token
WHATSAPP_API_VERSION=v21.0
# true = los mensajes salientes solo se loguean; false = envío real
WHATSAPP_MOCK_MODE=true

# Proveedor de WhatsApp: zernio | kapso | meta (vacío = el primero configurado)
WHATSAPP_PROVIDER=
SHARED_WHATSAPP_NUMBER=
FRONTEND_BASE_URL=https://sabi-ecru.vercel.app

# Zernio (inbox unificado; webhook POST /webhook/zernio)
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_ID=
ZERNIO_WEBHOOK_SECRET=

# Kapso (proxy de WhatsApp Cloud API; tiene prioridad sobre WHATSAPP_TOKEN)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

# Panel
SESSION_SECRET=change-me-in-production

# --- Asistente de eventos (demo FC Producciones) ---
# Siembra 3 eventos ficticios (is_demo) si el catálogo está vacío. Ponlo en false en producción real.
EVENTS_DEMO_SEED=true
EVENTS_MAX_QUANTITY=10
# Horas tras las cuales un precio/estado sin verificar se muestra como "requiere verificación"
EVENTS_STALE_HOURS=72
EVENTS_CHAT_LIMIT_HOUR=40
# (Opcional) dominios permitidos para el enlace oficial de compra, separados por coma. Vacío = cualquier https.
EVENTS_ALLOWED_PURCHASE_HOSTS=
# Panel admin: correos autorizados (coma) + contraseña compartida. Si faltan, el panel queda desactivado.
EVENTS_ADMIN_EMAILS=
EVENTS_ADMIN_PASSWORD=
