# Base de datos: SQLite local por defecto. Para Supabase/Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:<pass>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./sabi.db

# Anthropic (dejá AGENT_MOCK_MODE=true para probar sin API key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
AGENT_MOCK_MODE=true

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=sabi-verify-token
WHATSAPP_API_VERSION=v21.0
# true = los mensajes salientes solo se loguean; false = envío real
WHATSAPP_MOCK_MODE=true

# Panel
SESSION_SECRET=change-me-in-production
